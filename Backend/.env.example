# Server Configuration
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CLIENT_NAME=Social Media App

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/social_media

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
ACCESS_TOKEN_SECRET=your_access_token_secret_key_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRES_IN=7d
JWT_EMAIL_VERIFICATION_SECRET=your_email_verification_secret_key_here

# -------------------------------------------------------------
# EMAIL CONFIGURATION OPTIONS:
# -------------------------------------------------------------
# OPTION 1: Nodemailer with Gmail (RECOMMENDED for development & free testing)
# Works with ANY recipient email address without requiring a custom domain.
# Generate an App Password at: https://myaccount.google.com/apppasswords
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_gmail_address@gmail.com
# EMAIL_PASS=your_16_character_app_password
# EMAIL_FROM=your_gmail_address@gmail.com

# OPTION 2: Custom SMTP (Brevo, Mailgun, SendGrid, Mailtrap)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password

# OPTION 3: Resend API
# NOTE: Free tier without custom domain only allows sending to your Resend account email!
# To send to external users, verify your domain at: https://resend.com/domains
RESEND_API=re_your_resend_api_key_here
RESEND_FROM=onboarding@resend.dev

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
